{
  "name": "suti-view-2026",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.30.1",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "probe": "node --experimental-strip-types scripts/probe-mapping.ts",
    "probe:shake": "node --experimental-strip-types scripts/probe-shake.ts",
    "probe:slow": "node --experimental-strip-types scripts/probe-slow.ts",
    "probe:fullscreen": "node --experimental-strip-types --import ./scripts/dir-import-hook.mjs scripts/probe-fullscreen.ts",
    "probe:haptics": "node --experimental-strip-types scripts/probe-haptics.ts",
    "format": "prettier --write .",
    "deploy": "./deploy/deploy.sh"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/node": "^26.4.0",
    "@types/three": "^0.180.0",
    "eslint": "^9.18.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vite": "^6.0.7",
    "wrangler": "^3.99.0"
  }
}
